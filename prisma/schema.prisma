// VenuLynx - Smart Campus Venue Management System
// Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User roles in the system
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  REGISTRAR
  SUPER_ADMIN
}

// Booking status workflow
enum BookingStatus {
  PENDING_ADMIN      // Teacher submitted, waiting for Admin review
  PENDING_REGISTRAR  // Admin approved, waiting for Registrar approval
  APPROVED           // Registrar approved - booking confirmed
  REJECTED           // Rejected by Admin or Registrar
  CANCELLED          // Cancelled by teacher
  COMPLETED          // Event completed
}

// Venue types
enum VenueType {
  AUDITORIUM
  LECTURE_THEATRE
  BOARD_ROOM
  SEMINAR_HALL
  GD_ROOM
  LANGUAGE_LAB
  CLASSROOM
  TUTORIAL_ROOM
  COMPUTER_LAB
  CIVIL_ENGINEERING_LAB
  BASKETBALL_COURT
  BADMINTON_COURT
  COLLEGE_GROUND
  OPEN_CAFETERIA
}

// User model
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(TEACHER)
  phone         String?
  department    String?
  designation   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  bookings      Booking[]
  events        Event[]
  availability  TeacherAvailability?

  @@index([email])
  @@index([role])
}

// Venue model
model Venue {
  id            String     @id @default(cuid())
  name          String
  code          String     @unique
  type          VenueType
  building      String
  floor         String
  roomNumber    String
  capacity      Int
  facilities    String     // JSON string of facilities array
  description   String?
  imageUrl      String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  bookings      Booking[]
  events        Event[]

  @@index([type])
  @@index([building])
  @@index([isActive])
}
model Booking {
  id                String        @id @default(cuid())
  venueId           String
  userId            String
  eventDate         DateTime
  timeFrom          String        // Format: "HH:MM"
  timeTo            String        // Format: "HH:MM"
  participants      Int
  purpose           String
  remarks           String?

  refreshments      Boolean       @default(false)
  paSystem          Boolean       @default(false)

  status            BookingStatus @default(PENDING_ADMIN)

  // Approval tracking
  adminApprovedAt      DateTime?
  adminApprovedBy      String?
  adminRemarks         String?

  registrarApprovedAt  DateTime?
  registrarApprovedBy  String?
  registrarRemarks     String?

  rejectedAt        DateTime?
  rejectedBy        String?
  rejectionReason   String?

  // QR Code
  qrCode            String?
  qrGeneratedAt     DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  venue             Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event?

  @@index([venueId])
  @@index([userId])
  @@index([eventDate])
  @@index([status])
  @@index([venueId, eventDate])
}

// Event model (created after booking approval)
model Event {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  venueId       String
  userId        String
  title         String
  description   String?
  eventDate     DateTime
  timeFrom      String
  timeTo        String
  participants  Int
  qrCode        String   @unique
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venue         Venue    @relation(fields: [venueId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([eventDate])
  @@index([venueId])
  @@index([userId])
}

// Teacher availability toggle
model TeacherAvailability {
  id        String   @id @default(cuid())
  userId    String   @unique
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Analytics snapshot (for caching)
model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @unique
  totalBookings   Int      @default(0)
  approvedBookings Int     @default(0)
  rejectedBookings Int     @default(0)
  totalEvents     Int      @default(0)
  mostUsedVenue   String?
  busiestDay      String?
  createdAt       DateTime @default(now())
}
